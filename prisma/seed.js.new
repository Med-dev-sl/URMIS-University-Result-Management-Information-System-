import { PrismaClient } from '@prisma/client'
import bcrypt from 'bcryptjs'

const prisma = new PrismaClient()

async function upsertById(sql, params) {
  await prisma.$executeRawUnsafe(sql, ...params)
  const rows = await prisma.$queryRawUnsafe('SELECT last_insert_rowid() AS id')
  return Number(rows[0]?.id)
}

async function main() {
  await prisma.$connect()

  let institution = await prisma.institution.findFirst({ orderBy: { id: 'asc' } })

  if (!institution) {
    institution = await prisma.institution.create({
      data: {
        name: 'Greenfield University',
        address: '12 Learning Avenue, Lagos, Nigeria',
        contact_email: 'admin@greenfield.edu',
      },
    })
  }

  const institutionId = institution.id

  const faculties = []
  const facultyData = [
    { name: 'Faculty of Science' },
    { name: 'Faculty of Engineering' },
    { name: 'Faculty of Management Sciences' },
    { name: 'Faculty of Arts' },
  ]

  for (const faculty of facultyData) {
    let row = await prisma.faculty.findFirst({ where: { institutionId, name: faculty.name } })
    if (!row) {
      row = await prisma.faculty.create({ data: { institutionId, name: faculty.name } })
    }
    faculties.push(row)
  }

  const departments = []
  const departmentData = [
    { facultyIndex: 0, name: 'Computer Science' },
    { facultyIndex: 0, name: 'Biology' },
    { facultyIndex: 1, name: 'Electrical Engineering' },
    { facultyIndex: 1, name: 'Mechanical Engineering' },
    { facultyIndex: 2, name: 'Accounting' },
    { facultyIndex: 2, name: 'Business Administration' },
    { facultyIndex: 3, name: 'English Studies' },
    { facultyIndex: 3, name: 'History and International Studies' },
  ]

  for (const department of departmentData) {
    let row = await prisma.department.findFirst({ where: { institutionId, name: department.name } })
    if (!row) {
      row = await prisma.department.create({
        data: {
          institutionId,
          facultyId: faculties[department.facultyIndex].id,
          name: department.name,
        },
      })
    }
    departments.push(row)
  }

  const programmeIds = []
  const programmeData = [
    { code: 'BSC-CSC', name: 'Bachelor of Science in Computer Science', facultyIndex: 0, departmentIndex: 0, durationYears: 4 },
    { code: 'BENG-EEE', name: 'Bachelor of Engineering in Electrical Engineering', facultyIndex: 1, departmentIndex: 2, durationYears: 5 },
    { code: 'BBA-ACC', name: 'Bachelor of Business Administration in Accounting', facultyIndex: 2, departmentIndex: 4, durationYears: 4 },
    { code: 'BA-ENG', name: 'Bachelor of Arts in English Studies', facultyIndex: 3, departmentIndex: 6, durationYears: 4 },
  ]

  for (const programme of programmeData) {
    const existing = await prisma.$queryRawUnsafe('SELECT id FROM Programme WHERE institutionId = ? AND code = ? LIMIT 1', institutionId, programme.code)
    let programmeId

    if (existing.length) {
      programmeId = Number(existing[0].id)
    } else {
      programmeId = await upsertById(
        `INSERT INTO Programme (institutionId, facultyId, departmentId, code, name, durationYears, description, isActive, created_at, updated_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`,
        [institutionId, faculties[programme.facultyIndex].id, departments[programme.departmentIndex].id, programme.code, programme.name, programme.durationYears, `${programme.name} programme offered at ${institution.name}`, 1],
      )
    }

    programmeIds.push(programmeId)
  }

  const academicSessionIds = []
  const sessionNames = ['2023/2024', '2024/2025', '2025/2026']
  for (const [index, name] of sessionNames.entries()) {
    const existing = await prisma.$queryRawUnsafe('SELECT id FROM AcademicSession WHERE institutionId = ? AND name = ? LIMIT 1', institutionId, name)
    let sessionId

    if (existing.length) {
      sessionId = Number(existing[0].id)
    } else {
      sessionId = await upsertById(
        `INSERT INTO AcademicSession (institutionId, name, startDate, endDate, isCurrent, created_at, updated_at)
         VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`,
        [institutionId, name, `${index === 0 ? '2023' : index === 1 ? '2024' : '2025'}-09-01T00:00:00.000Z`, `${index === 0 ? '2024' : index === 1 ? '2025' : '2026'}-07-30T00:00:00.000Z`, index === 2 ? 1 : 0],
      )
    }

    academicSessionIds.push(sessionId)
  }

  const semesterDefinitions = [
    { name: 'First Semester', code: 'HARM1', sequence: 1 },
    { name: 'Second Semester', code: 'HARM2', sequence: 2 },
  ]
  for (const [index, sessionId] of academicSessionIds.entries()) {
    for (const semester of semesterDefinitions) {
      const sessionName = sessionNames[index]
      const existing = await prisma.$queryRawUnsafe('SELECT id FROM Semester WHERE institutionId = ? AND academicSessionId = ? AND code = ? LIMIT 1', institutionId, sessionId, `${sessionName.replace('/', '')}-${semester.code}`)
      if (!existing.length) {
        await upsertById(
          `INSERT INTO Semester (institutionId, academicSessionId, name, code, sequence, isCurrent, created_at, updated_at)
           VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`,
          [institutionId, sessionId, semester.name, `${sessionName.replace('/', '')}-${semester.code}`, semester.sequence, index === academicSessionIds.length - 1 && semester.sequence === 1 ? 1 : 0],
        )
      }
    }
  }

  const levelDefinitions = [
    { name: '100 Level', code: '100', sequence: 1 },
    { name: '200 Level', code: '200', sequence: 2 },
    { name: '300 Level', code: '300', sequence: 3 },
    { name: '400 Level', code: '400', sequence: 4 },
  ]
  const levelIds = []
  for (const level of levelDefinitions) {
    const existing = await prisma.$queryRawUnsafe('SELECT id FROM Level WHERE institutionId = ? AND code = ? LIMIT 1', institutionId, level.code)
    let levelId
    if (existing.length) {
      levelId = Number(existing[0].id)
    } else {
      levelId = await upsertById(
        `INSERT INTO Level (institutionId, name, code, sequence, isCurrent, created_at, updated_at)
         VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`,
        [institutionId, level.name, level.code, level.sequence, level.sequence === 4 ? 1 : 0],
      )
    }
    levelIds.push(levelId)
  }

  const gradeScaleData = [
    { gradeLetter: 'A', minimumScore: 70, maximumScore: 100, gradePoint: 5, description: 'Excellent', isDefault: true },
    { gradeLetter: 'B', minimumScore: 60, maximumScore: 69, gradePoint: 4, description: 'Very Good' },
    { gradeLetter: 'C', minimumScore: 50, maximumScore: 59, gradePoint: 3, description: 'Good' },
    { gradeLetter: 'D', minimumScore: 45, maximumScore: 49, gradePoint: 2, description: 'Pass' },
    { gradeLetter: 'E', minimumScore: 40, maximumScore: 44, gradePoint: 1, description: 'Low Pass' },
    { gradeLetter: 'F', minimumScore: 0, maximumScore: 39, gradePoint: 0, description: 'Fail' },
  ]
  for (const item of gradeScaleData) {
    const existing = await prisma.$queryRawUnsafe('SELECT id FROM GradeScale WHERE institutionId = ? AND gradeLetter = ? LIMIT 1', institutionId, item.gradeLetter)
    if (!existing.length) {
      await upsertById(
        `INSERT INTO GradeScale (institutionId, gradeLetter, minimumScore, maximumScore, gradePoint, description, isDefault, created_at, updated_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`,
        [institutionId, item.gradeLetter, item.minimumScore, item.maximumScore, item.gradePoint, item.description, item.isDefault ? 1 : 0],
      )
    }
  }

  const existingGPA = await prisma.$queryRawUnsafe('SELECT id FROM GPAConfiguration WHERE institutionId = ? AND name = ? LIMIT 1', institutionId, 'Default GPA')
  if (!existingGPA.length) {
    await upsertById(
      `INSERT INTO GPAConfiguration (institutionId, name, gradingBasis, minimumPassingGrade, maxCreditLoad, includeCarryOver, created_at, updated_at)
       VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)`,
      [institutionId, 'Default GPA', '4.0', 'D', 24, 0],
    )
  }

  const courseData = [
    { departmentIndex: 0, programmeIndex: 0, code: 'CSC101', name: 'Introduction to Computing', hours: 3 },
    { departmentIndex: 0, programmeIndex: 0, code: 'CSC201', name: 'Data Structures', hours: 3 },
    { departmentIndex: 2, programmeIndex: 1, code: 'EEE201', name: 'Circuit Theory I', hours: 3 },
    { departmentIndex: 4, programmeIndex: 2, code: 'ACC201', name: 'Financial Accounting', hours: 3 },
    { departmentIndex: 6, programmeIndex: 3, code: 'ENG201', name: 'Advanced English Composition', hours: 2 },
  ]
  const courseIds = []
  for (const course of courseData) {
    const existing = await prisma.$queryRawUnsafe('SELECT id FROM Course WHERE institutionId = ? AND course_code = ? LIMIT 1', institutionId, course.code)
    let courseId
    if (existing.length) {
      courseId = Number(existing[0].id)
    } else {
      courseId = await upsertById(
        `INSERT INTO Course (institutionId, departmentId, programmeId, course_code, course_name, credit_hours, created_at)
         VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,
        [institutionId, departments[course.departmentIndex].id, programmeIds[course.programmeIndex], course.code, course.name, course.hours],
      )
    }
    courseIds.push(courseId)
  }

  const usersData = [
    { full_name: 'Moses Adeyemi', email: 'superadmin@greenfield.edu', password: 'SuperAdmin@123', role: 'super_admin' },
    { full_name: 'Aisha Bello', email: 'admin@greenfield.edu', password: 'Admin@123', role: 'admin' },
    { full_name: 'Dr. Chima Okafor', email: 'dean@greenfield.edu', password: 'Dean@123', role: 'dean' },
    { full_name: 'Prof. Grace Ibrahim', email: 'hod@greenfield.edu', password: 'Hod@123', role: 'hod' },
    { full_name: 'Mr. Tunde Salami', email: 'lecturer@greenfield.edu', password: 'Lecturer@123', role: 'lecturer' },
  ]
  const users = []
  for (const userData of usersData) {
    let user = await prisma.user.findFirst({ where: { email: userData.email } })
    if (!user) {
      user = await prisma.user.create({
        data: {
          institutionId,
          full_name: userData.full_name,
          email: userData.email,
          password_hash: await bcrypt.hash(userData.password, 10),
          role: userData.role,
          email_verified: true,
          updated_at: new Date(),
        },
      })
    }
    users.push(user)
  }

  const studentData = [
    { full_name: 'Daniel Adebayo', student_id: 'CS-2024-001', departmentIndex: 0, levelIndex: 3 },
    { full_name: 'Grace Okafor', student_id: 'CS-2024-002', departmentIndex: 0, levelIndex: 3 },
    { full_name: 'Emmanuel Nwosu', student_id: 'CS-2024-003', departmentIndex: 1, levelIndex: 2 },
    { full_name: 'Fatima Yusuf', student_id: 'BA-2024-001', departmentIndex: 4, levelIndex: 1 },
    { full_name: 'Michael Johnson', student_id: 'BA-2024-002', departmentIndex: 4, levelIndex: 1 },
  ]
  const students = []
  for (const student of studentData) {
    let existing = await prisma.student.findFirst({ where: { student_id: student.student_id } })
    if (!existing) {
      existing = await prisma.student.create({
        data: {
          institutionId,
          departmentId: departments[student.departmentIndex].id,
          student_id: student.student_id,
          full_name: student.full_name,
          semester: levelDefinitions[student.levelIndex].name,
          enrollment_year: '2024',
        },
      })
    }
    students.push(existing)
  }

  let workflow = await prisma.approvalWorkflow.findFirst({ where: { institutionId, name: 'Result Publication Workflow' } })
  if (!workflow) {
    workflow = await prisma.approvalWorkflow.create({
      data: {
        institutionId,
        name: 'Result Publication Workflow',
        description: 'Review and publish student results through the academic board process.',
        is_active: true,
        stages: {
          create: [
            { name: 'Lecturer Review', role: 'lecturer', stage_order: 1 },
            { name: 'HOD Review', role: 'hod', stage_order: 2 },
            { name: 'Dean Approval', role: 'dean', stage_order: 3 },
          ],
        },
      },
    })
  }

  const platformSettings = [
    { key: 'site_name', value: 'URMIS', category: 'general', description: 'Institution portal name' },
    { key: 'default_language', value: 'en', category: 'general', description: 'Default portal language' },
    { key: 'result_publication_enabled', value: 'true', category: 'results', description: 'Allow result publication workflow' },
    { key: 'allow_student_self_registration', value: 'true', category: 'students', description: 'Allow student self registration' },
  ]
  for (const setting of platformSettings) {
    const existing = await prisma.platformSetting.findFirst({ where: { key: setting.key } })
    if (!existing) {
      await prisma.platformSetting.create({ data: setting })
    }
  }

  let registrationPeriod = await prisma.registrationPeriod.findFirst({ where: { institutionId, name: '2025/2026 Harmattan Registration' } })
  if (!registrationPeriod) {
    registrationPeriod = await prisma.registrationPeriod.create({
      data: {
        institutionId,
        name: '2025/2026 Harmattan Registration',
        academicSession: sessionNames[2],
        status: 'open',
        openedAt: new Date('2025-08-01T00:00:00.000Z'),
        closedAt: new Date('2025-08-31T23:59:59.000Z'),
        maxCreditUnits: 24,
      },
    })
  }

  const sampleResults = [
    { studentIndex: 0, courseIndex: 0, assignment_score: 82, exam_score: 88, percentage: 85, grade: 'A' },
    { studentIndex: 1, courseIndex: 1, exam_score: 74, assignment_score: 68, percentage: 71, grade: 'B' },
    { studentIndex: 2, courseIndex: 2, assignment_score: 55, exam_score: 60, percentage: 58, grade: 'C' },
    { studentIndex: 3, courseIndex: 3, assignment_score: 48, exam_score: 52, percentage: 50, grade: 'C' },
    { studentIndex: 4, courseIndex: 4, assignment_score: 40, exam_score: 38, percentage: 39, grade: 'F' },
  ]
  for (const resultData of sampleResults) {
    const student = students[resultData.studentIndex]
    const courseId = courseIds[resultData.courseIndex]
    const existingResult = await prisma.result.findFirst({ where: { institutionId, studentId: student.id, courseId } })
    if (!existingResult) {
      await prisma.result.create({
        data: {
          institutionId,
          studentId: student.id,
          courseId,
          assignment_score: resultData.assignment_score,
          exam_score: resultData.exam_score,
          total_score: resultData.assignment_score + resultData.exam_score,
          percentage: resultData.percentage,
          grade: resultData.grade,
          pass_fail: resultData.percentage >= 45 ? 'PASS' : 'FAIL',
          academic_session: sessionNames[2],
        },
      })
    }
  }

  const existingRegistration = await prisma.registration.findFirst({ where: { studentId: students[0].id, registrationPeriodId: registrationPeriod.id } })
  if (!existingRegistration) {
    await prisma.registration.create({
      data: {
        institutionId,
        studentId: students[0].id,
        registrationPeriodId: registrationPeriod.id,
        status: 'submitted',
        totalCreditUnits: 6,
        submittedAt: new Date(),
        approvedAt: new Date(),
        courses: {
          create: [
            { courseId: courseIds[0], creditUnits: 3 },
            { courseId: courseIds[1], creditUnits: 3 },
          ],
        },
      },
    })
  }

  console.log('Seed completed successfully with institution, academic structure, users, workflow, settings, registration data, and sample results.')
}

main()
  .catch((error) => {
    console.error('Seed failed:', error)
    process.exit(1)
  })
  .finally(async () => {
    await prisma.$disconnect()
  })
