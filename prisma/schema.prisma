generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Mirror of current SQLite schema (initial)
model Institution {
  id           Int      @id @default(autoincrement())
  name         String
  address      String?
  contact_email String?
  created_at   DateTime @default(now())
  users        User[]
  faculties    Faculty[]
  departments  Department[]
  students     Student[]
  courses      Course[]
  modules      Module[]
  results      Result[]
  transcriptRequests TranscriptRequest[]
  transcripts  Transcript[]
  notifications Notification[]
  auditLogs    AuditLog[]
  assessments  Assessment[]
  assessmentScores AssessmentScore[]
  approvalWorkflows ApprovalWorkflow[]
  approvalTasks ApprovalTask[]
  uploadedDocuments UploadedDocument[]
  documents Document[]
  documentFolders DocumentFolder[]
  documentVersions DocumentVersion[]
  institutionSettings InstitutionSetting[]
  registrationPeriods RegistrationPeriod[]
  registrations Registration[]
  programmes Programme[]
  academicSessions AcademicSession[]
  semesters Semester[]
  levels Level[]
  gradeScales GradeScale[]
  gpaConfigurations GPAConfiguration[]
}

model User {
  id                 Int     @id @default(autoincrement())
  institutionId      Int?
  full_name          String
  email              String  @unique
  password_hash      String
  refresh_token      String?
  role               String  @default("admin")
  isSuspended        Boolean @default(false)
  isLocked           Boolean @default(false)
  mustChangePassword Boolean @default(false)
  lockedAt           DateTime?
  suspendedAt        DateTime?
  lastPasswordChange DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now())
  institution        Institution? @relation(fields: [institutionId], references: [id])
  transcriptRequests TranscriptRequest[]  @relation("TranscriptRequester")
  generatedTranscripts Transcript[]      @relation("TranscriptGenerator")
  sentNotifications Notification[]        @relation("NotificationSender")
  receivedNotifications Notification[]    @relation("NotificationRecipient")
  notificationReads NotificationRead[]
  approvalHistory ApprovalHistory[]
  approvalComments ApprovalComment[]
  publicationLogs PublicationLog[]
  uploadedDocuments UploadedDocument[]  @relation("UploaderDocuments")
  auditLogs AuditLog[]
  documents Document[]
  documentFolders DocumentFolder[]
  documentVersions DocumentVersion[]
}

model RolePermission {
  id          Int      @id @default(autoincrement())
  role        String
  permission  String
  granted     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@unique([role, permission])
}

model Faculty {
  id            Int     @id @default(autoincrement())
  institutionId Int
  name          String
  created_at    DateTime @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  departments   Department[]
  programmes    Programme[]
}

model Department {
  id            Int     @id @default(autoincrement())
  institutionId Int
  facultyId     Int?
  name          String
  created_at    DateTime @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  faculty       Faculty? @relation(fields: [facultyId], references: [id])
  students      Student[]
  courses       Course[]
  programmes    Programme[]
}

model Programme {
  id            Int     @id @default(autoincrement())
  institutionId Int
  facultyId     Int?
  departmentId  Int?
  code          String
  name          String
  durationYears Int     @default(4)
  description   String?
  isActive      Boolean @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  faculty       Faculty? @relation(fields: [facultyId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  courses       Course[]

  @@unique([institutionId, code])
}

model AcademicSession {
  id            Int      @id @default(autoincrement())
  institutionId Int
  name          String
  startDate     DateTime?
  endDate       DateTime?
  isCurrent     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  semesters     Semester[]

  @@unique([institutionId, name])
}

model Semester {
  id                 Int      @id @default(autoincrement())
  institutionId      Int
  academicSessionId Int
  name               String
  code               String
  sequence           Int      @default(1)
  isCurrent          Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  institution        Institution @relation(fields: [institutionId], references: [id])
  academicSession    AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@unique([academicSessionId, code])
}

model Level {
  id            Int      @id @default(autoincrement())
  institutionId Int
  name          String
  code          String
  sequence      Int      @default(1)
  isCurrent     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, code])
}

model GradeScale {
  id            Int      @id @default(autoincrement())
  institutionId Int
  gradeLetter   String
  minimumScore  Float
  maximumScore  Float
  gradePoint    Float
  description   String?
  isDefault     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, gradeLetter])
}

model GPAConfiguration {
  id               Int      @id @default(autoincrement())
  institutionId    Int
  name             String   @default("Default GPA")
  gradingBasis     String   @default("4.0")
  minimumPassingGrade String @default("D")
  maxCreditLoad    Int      @default(24)
  includeCarryOver Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  institution      Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, name])
}

model Student {
  id            Int     @id @default(autoincrement())
  institutionId Int
  student_id    String
  full_name     String
  departmentId  Int?
  semester      String?
  enrollment_year String?
  created_at    DateTime @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  results       Result[]
  transcriptRequests TranscriptRequest[]
  transcripts    Transcript[]
  registrations Registration[]
  assessmentScores AssessmentScore[]
}

model Course {
  id            Int     @id @default(autoincrement())
  institutionId Int
  departmentId  Int?
  programmeId   Int?
  course_code   String
  course_name   String
  credit_hours  Int     @default(3)
  created_at    DateTime @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  programme     Programme? @relation(fields: [programmeId], references: [id])
  modules       Module[]
  results       Result[]
  assessments   Assessment[]
  registrationCourses RegistrationCourse[]
}

model Assessment {
  id                Int      @id @default(autoincrement())
  institutionId     Int
  courseId          Int
  title             String
  academicSession   String
  semester          String?
  description       String?
  status            String   @default("draft")
  reviewStatus      String   @default("pending")
  publishedAt       DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  institution       Institution @relation(fields: [institutionId], references: [id])
  course            Course     @relation(fields: [courseId], references: [id])
  weights           AssessmentWeight[]
  scores            AssessmentScore[]
}

model AssessmentWeight {
  id            Int      @id @default(autoincrement())
  assessmentId  Int
  component     String
  weight        Int      @default(0)
  created_at    DateTime @default(now())

  assessment    Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([assessmentId, component])
}

model AssessmentScore {
  id                Int      @id @default(autoincrement())
  assessmentId      Int
  studentId         Int
  institutionId     Int?
  caScore           Float?
  assignmentScore   Float?
  practicalScore    Float?
  examScore         Float?
  finalMark         Float?
  grade             String?
  status            String   @default("draft")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  assessment        Assessment @relation(fields: [assessmentId], references: [id])
  student           Student    @relation(fields: [studentId], references: [id])
  institution       Institution? @relation(fields: [institutionId], references: [id])

  @@unique([assessmentId, studentId])
}

model Module {
  id            Int     @id @default(autoincrement())
  institutionId Int
  courseId      Int
  module_code   String
  module_name   String
  credit_hours  Int     @default(1)
  description   String?
  created_at    DateTime @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  course        Course   @relation(fields: [courseId], references: [id])
}

model Result {
  id            Int     @id @default(autoincrement())
  institutionId Int
  studentId     Int
  courseId      Int
  assignment_score Float @default(0)
  exam_score     Float  @default(0)
  total_score    Float  @default(0)
  percentage     Float  @default(0)
  grade          String?
  pass_fail      String?
  academic_session String?
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institutionId], references: [id])
  student        Student     @relation(fields: [studentId], references: [id])
  course         Course      @relation(fields: [courseId], references: [id])
}

model TranscriptRequest {
  id               Int       @id @default(autoincrement())
  institutionId    Int
  studentId        Int
  requested_by     Int
  purpose          String
  delivery_address String?
  status           String    @default("pending")
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  institution      Institution @relation(fields: [institutionId], references: [id])
  student          Student     @relation(fields: [studentId], references: [id])
  requester        User        @relation("TranscriptRequester", fields: [requested_by], references: [id])
}

model Transcript {
  id               Int       @id @default(autoincrement())
  institutionId    Int
  studentId        Int
  generated_by     Int
  academic_session String
  content          String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  institution      Institution @relation(fields: [institutionId], references: [id])
  student          Student     @relation(fields: [studentId], references: [id])
  generator        User        @relation("TranscriptGenerator", fields: [generated_by], references: [id])
}

model Notification {
  id            Int             @id @default(autoincrement())
  institutionId Int
  senderId      Int
  recipientId   Int?
  title         String
  message       String
  category      String          @default("general")
  channel       String          @default("in-app")
  status        String          @default("active")
  is_global     Boolean         @default(false)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  institution   Institution      @relation(fields: [institutionId], references: [id])
  sender        User             @relation("NotificationSender", fields: [senderId], references: [id])
  recipient     User?            @relation("NotificationRecipient", fields: [recipientId], references: [id])
  reads         NotificationRead[]
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  userId         Int
  read_at        DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId], name: "notificationId_userId")
}

model UploadedDocument {
  id            Int       @id @default(autoincrement())
  institutionId Int
  uploaded_by   Int
  original_name String
  stored_name   String
  mime_type     String
  size          Int
  category      String    @default("general")
  description   String?
  path          String
  url           String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])
  uploader      User        @relation("UploaderDocuments", fields: [uploaded_by], references: [id])
}

model DocumentFolder {
  id              Int       @id @default(autoincrement())
  institutionId   Int
  createdBy       Int
  name            String
  parentFolderId  Int?
  description     String?
  isArchived      Boolean   @default(false)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id])
  creator         User        @relation(fields: [createdBy], references: [id])
  parentFolder    DocumentFolder? @relation("FolderChildren", fields: [parentFolderId], references: [id])
  children        DocumentFolder[] @relation("FolderChildren")
  documents       Document[]
}

model Document {
  id              Int       @id @default(autoincrement())
  institutionId   Int
  folderId        Int?
  uploadedBy      Int
  faculty         String?
  department      String?
  title           String
  description     String?
  fileName        String
  storedName      String
  mimeType        String
  size            Int
  version         Int       @default(1)
  isArchived      Boolean   @default(false)
  archivedAt      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id])
  folder          DocumentFolder? @relation(fields: [folderId], references: [id])
  uploader        User        @relation(fields: [uploadedBy], references: [id])
  versions        DocumentVersion[]
}

model DocumentVersion {
  id              Int       @id @default(autoincrement())
  institutionId   Int
  documentId      Int
  uploadedBy      Int
  versionNumber   Int
  fileName        String
  storedName      String
  mimeType        String
  size            Int
  changeSummary   String?
  created_at      DateTime  @default(now())

  institution     Institution @relation(fields: [institutionId], references: [id])
  document        Document   @relation(fields: [documentId], references: [id])
  uploader        User        @relation(fields: [uploadedBy], references: [id])

  @@unique([documentId, versionNumber])
}

model InstitutionSetting {
  id            Int       @id @default(autoincrement())
  institutionId Int
  key           String
  value         String
  category      String    @default("general")
  description   String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, key])
}

model RegistrationPeriod {
  id                 Int       @id @default(autoincrement())
  institutionId      Int
  name               String
  academicSession    String
  status             String    @default("draft")
  openedAt           DateTime?
  closedAt           DateTime?
  maxCreditUnits     Int       @default(24)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  institution        Institution @relation(fields: [institutionId], references: [id])
  registrations      Registration[]

  @@unique([institutionId, academicSession, name])
}

model Registration {
  id                 Int       @id @default(autoincrement())
  institutionId      Int
  studentId          Int
  registrationPeriodId Int
  status             String    @default("draft")
  totalCreditUnits   Int       @default(0)
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  institution        Institution @relation(fields: [institutionId], references: [id])
  student            Student    @relation(fields: [studentId], references: [id])
  registrationPeriod RegistrationPeriod @relation(fields: [registrationPeriodId], references: [id])
  courses            RegistrationCourse[]

  @@unique([studentId, registrationPeriodId])
}

model RegistrationCourse {
  id                 Int       @id @default(autoincrement())
  registrationId     Int
  courseId           Int
  creditUnits        Int
  created_at         DateTime  @default(now())

  registration       Registration @relation(fields: [registrationId], references: [id])
  course             Course       @relation(fields: [courseId], references: [id])

  @@unique([registrationId, courseId])
}

model PlatformSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  category    String   @default("general")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("PlatformSetting")
}

model ApprovalWorkflow {
  id            Int             @id @default(autoincrement())
  institutionId Int
  name          String
  description   String?
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  institution   Institution      @relation(fields: [institutionId], references: [id])
  stages        ApprovalStage[]
  tasks         ApprovalTask[]
}

model ApprovalStage {
  id         Int              @id @default(autoincrement())
  workflowId Int
  name       String
  role       String
  stage_order Int
  is_active  Boolean          @default(true)
  created_at DateTime         @default(now())

  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  history    ApprovalHistory[]
  tasks      ApprovalTask[]   @relation("CurrentStageTasks")
}

model ApprovalTask {
  id             Int              @id @default(autoincrement())
  workflowId     Int
  institutionId  Int
  target_type    String
  target_id      Int
  title          String
  description    String?
  status         String           @default("pending")
  currentStageId Int?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  workflow       ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  currentStage   ApprovalStage?   @relation("CurrentStageTasks", fields: [currentStageId], references: [id])
  history        ApprovalHistory[]
  comments       ApprovalComment[]
  publicationLogs PublicationLog[]
  institution    Institution      @relation(fields: [institutionId], references: [id])
}

model ApprovalHistory {
  id         Int           @id @default(autoincrement())
  taskId     Int
  stageId    Int?
  actorId    Int
  action     String
  comment    String?
  created_at DateTime      @default(now())

  task       ApprovalTask  @relation(fields: [taskId], references: [id])
  stage      ApprovalStage? @relation(fields: [stageId], references: [id])
  actor      User          @relation(fields: [actorId], references: [id])
}

model ApprovalComment {
  id         Int           @id @default(autoincrement())
  taskId     Int
  authorId   Int
  message    String
  created_at DateTime      @default(now())

  task       ApprovalTask  @relation(fields: [taskId], references: [id])
  author     User          @relation(fields: [authorId], references: [id])
}

model PublicationLog {
  id           Int           @id @default(autoincrement())
  taskId       Int
  published_by Int
  note         String?
  created_at   DateTime      @default(now())

  task         ApprovalTask  @relation(fields: [taskId], references: [id])
  publishedBy  User          @relation(fields: [published_by], references: [id])
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  institutionId Int?
  userId        Int?
  route         String
  method        String
  action        String
  details       String?
  ip            String?
  user_agent    String?
  created_at    DateTime  @default(now())

  institution   Institution? @relation(fields: [institutionId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])
}
